# 知间（Zhijian）容器部署环境变量
#
# 用法：
#   cp .env.example .env
#   # 改掉下面标了「必须改」的项
#   docker compose up -d --build
#
# ⚠️ .env 里是真实口令，不要提交进 git（.gitignore 已忽略 .env）。

# ── 对外地址 ───────────────────────────────────────────────────────────
# 宿主机映射端口。默认只绑 127.0.0.1，对外请用 nginx/Caddy 反代 + TLS。
APP_PORT=5056

# 「一键复制 MCP 配置」和 Server Card 里生成的地址。
# 不填则生成 http://127.0.0.1:5056/mcp —— 别人在自己机器上连不通。
# 例：PUBLIC_BASE_URL=https://knowspace.example.com
PUBLIC_BASE_URL=

# ── 安全（对外暴露前必须改）─────────────────────────────────────────────
# /api 的访问令牌，随便一串 32 字节十六进制：openssl rand -hex 32
# 留空 = /api 不鉴权（只适合「只绑回环地址的自用部署」）。
MAF_SERVER_TOKEN=

# 内置 PostgreSQL 的口令。默认 postgres 等于没锁，务必改：openssl rand -hex 24
PG_PASSWORD=postgres

# 反向代理与 API 不在同一台机器时才设 true，否则按 IP 封禁会把代理地址
# 当成客户端（一个人爆破导致所有人连坐）。
TRUST_FORWARDED_HEADERS=false

# ── 聊天模型（OpenAI 兼容接口）─────────────────────────────────────────
# 也可以在「设置」页里改，改完立即生效，不必重启。
LLM_ENDPOINT=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# ── 语音转写（Whisper）─────────────────────────────────────────────────
# true = 首次使用按需下载模型到卷里；离线环境设 false，再从「设置 → 语音转写」导入 ggml 文件。
AUTO_DOWNLOAD_WHISPER=true
