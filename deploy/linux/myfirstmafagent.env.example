# 知间（MyFirstMafAgent）服务配置 —— /etc/myfirstmafagent/myfirstmafagent.env
#
# 语法：KEY=VALUE，一行一条，不要加引号、不要写 export。
# systemd 的 EnvironmentFile 只做「原样读入」，引号会变成值的一部分。
#
# 改完：systemctl restart myfirstmafagent
# 看日志：journalctl -u myfirstmafagent -f

# ─── 身份与对外地址（必看）─────────────────────────────────────────────

# 保护 /api。生成：openssl rand -hex 32
# 置空 = /api 不鉴权。**只适合「只监听回环、自用」**的场景。
# 注意：设置之后浏览器里的前端无法直接调 /api（令牌原本由 Electron 注入），
# 必须在反向代理层认证通过后注入 X-Api-Token，否则界面会一直 401。
MAF_SERVER_TOKEN=

# 放行未鉴权的 /api/health，给负载均衡 / 监控 / 容器探活用。
Server__AllowAnonymousHealth=true

# 对外可达的基地址，例如 https://knowspace.example.com
# 只影响「设置 → MCP 接入配置（一键复制）」生成的地址，不参与鉴权。
# 不填的话，复制出来的是 http://127.0.0.1:5056/mcp，别人本机连不上。
Server__PublicBaseUrl=

# 放在反向代理后面时**必须**开，否则审计日志里的来源 IP 全是 127.0.0.1，
# 而且按 IP 封禁会把代理地址当成客户端（一个人爆破，全体连坐）。
Server__TrustForwardedHeaders=false
# 代理与 API 不同机时填代理的真实 IP（多个用 Server__KnownProxies__1 递增）。
# Server__KnownProxies__0=10.0.0.5

# ─── 内置数据库（默认形态）────────────────────────────────────────────

# 用 apt 装的 PostgreSQL 17，不随包分发便携树（便携树只有 win-x64 一份）。
PortablePostgres__Enabled=true
PortablePostgres__BinDirectory=/usr/lib/postgresql/17/bin

# 数据根目录：pgdata / pglogs / pgsockets 都建在它下面。
# 必须由服务账号可写，且**必须与程序目录分离**（升级/回滚时不连带数据）。
PortablePostgres__RootDirectory=/var/lib/myfirstmafagent

PortablePostgres__Port=55432
PortablePostgres__Username=postgres
# 首次 initdb 时写入；改这里不会改已有集群的口令（要改请用 psql ALTER USER）。
PortablePostgres__Password=CHANGE_ME_STRONG_PASSWORD
PortablePostgres__Database=myfirstmafagent

# 上传的资料 / 语音模型放这里。
# 附带作用：OAuth 签名私钥会落在它的**上层目录**下的 oauth/signing-key.pem，
# 即 /var/lib/myfirstmafagent/oauth/。不设的话会落到程序目录（root 属主，写不进去）。
Storage__RootPath=/var/lib/myfirstmafagent/uploads

# ─── 可选：改用外部 PostgreSQL ────────────────────────────────────────
# 保留上面两段即可，只把下面两行打开（Enabled=false + 连接串），
# 程序会自动跳过内置库、只连外部实例。pgvector 扩展需要你自己装好。
# PortablePostgres__Enabled=false
# ConnectionStrings__KnowledgeBase=Host=127.0.0.1;Port=5432;Database=myfirstmafagent;Username=knowspace;Password=CHANGE_ME

# ─── 聊天模型（OpenAI 兼容；也可在「设置」页里改）─────────────────────
Llm__UseCloudApi=true
Llm__Online__Endpoint=https://api.deepseek.com/v1
Llm__Online__Model=deepseek-chat
Llm__Online__ApiKey=

# ─── 可选：OAuth 2.1（面向普通用户的授权方式）─────────────────────────
# 开启后客户端走「浏览器点同意」，不再需要复制 maf_ 密钥。
# Issuer 必须是客户端能访问到的绝对地址：https，或回环 http。
# 填错/非法的后果是 OAuth 自动禁用（仍可用 maf_ 通道），启动日志会有警告。
# Mcp__OAuth__Enabled=true
# Mcp__OAuth__Issuer=https://knowspace.example.com

# ─── 可选：语音转写模型 ───────────────────────────────────────────────
# 离线环境设 false，再从「设置 → 语音转写」导入本地 ggml 文件。
Media__AutoDownloadWhisperModel=true
