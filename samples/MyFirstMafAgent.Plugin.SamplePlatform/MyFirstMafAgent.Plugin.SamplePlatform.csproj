<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MyFirstMafAgent.Plugin.SamplePlatform</AssemblyName>
    <RootNamespace>MyFirstMafAgent.Plugin.SamplePlatform</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MyFirstMafAgent.Plugins.Sdk\MyFirstMafAgent.Plugins.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- manifest 放在输出目录，使 bin 输出本身就是一个合法的插件目录。 -->
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
