{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://127.0.0.1:5056",
  "Desktop": {
    "OpenBrowser": true,
    "OpenBrowserInDevelopment": false
  },
  "PortablePostgres": {
    "Enabled": true,
    "RespectExternalConnectionString": true,
    "PreflightTimeoutSeconds": 5,
    "BinDirectory": "",
    "Port": 55432,
    "RootDirectory": "",
    "DataDirectory": "",
    "Username": "postgres",
    "Password": "postgres",
    "Database": "myfirstmafagent",
    "StartupTimeoutSeconds": 120,
    "StopOnExit": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Server": {
    "ApiToken": "",
    "AllowAnonymousHealth": false,
    "TrustForwardedHeaders": false,
    "KnownProxies": [],
    "FailedAuthLimitPerMinute": 30,
    "FailedAuthBlockSeconds": 300,
    "HideServerHeader": true
  },
  "Llm": {
    "UseCloudApi": true,
    "Local": {
      "Endpoint": "http://localhost:1234/v1",
      "Model": "local-model",
      "ApiKey": "local"
    },
    "Online": {
      "Endpoint": "https://api.deepseek.com/v1",
      "Model": "deepseek-chat",
      "ApiKey": ""
    }
  },
  "Storage": {
    "RootPath": "App_Data/uploads",
    "MaxFileSizeBytes": 52428800,
    "MaxVideoFileSizeBytes": 5368709120,
    "UploadChunkSizeBytes": 16777216
  },
  "ConnectionStrings": {
    "KnowledgeBase": ""
  },
  "Embedding": {
    "ModelDirectory": "ExternalTools/Embedding/bge-small-zh-v1.5",
    "Dimensions": 512,
    "MaxSequenceLength": 512,
    "IntraOpNumThreads": 0,
    "DefaultSpecName": "bge-small-zh-v1.5",
    "ModelRootPath": "App_Data/models/embedding",
    "MaxModelFileSizeBytes": 1073741824,
    "Specs": [
      {
        "Name": "bge-small-zh-v1.5",
        "Provider": "onnx-local",
        "Model": "bge-small-zh-v1.5",
        "Dimensions": 512,
        "MaxSequenceLength": 512,
        "Revision": "1",
        "ModelDirectory": "ExternalTools/Embedding/bge-small-zh-v1.5",
        "IntraOpNumThreads": 0
      }
    ]
  },
  "Indexing": {
    "RollbackWindowMinutes": 60,
    "OutboxRetentionHours": 168,
    "PollIntervalSeconds": 2,
    "QualityProbeCount": 8,
    "RequireConsistencyBeforeActivation": true
  },
  "Retrieval": {
    "HybridEnabled": true,
    "RrfK": 60,
    "CandidateMultiplier": 3,
    "MaxCandidates": 60,
    "RerankEnabled": true,
    "RerankCandidateLimit": 60,
    "RerankLexicalWeight": 0.65,
    "AbstainEnabled": false,
    "AbstainMinScore": 0.45
  },
  "Media": {
    "FfmpegPath": "",
    "WhisperModel": "Base",
    "WhisperModelPath": "App_Data/models/ggml-base.bin",
    "AutoDownloadWhisperModel": true,
    "MaxWhisperModelBytes": 3221225472,
    "EnableVideoFrameAnalysis": true,
    "FrameSampleIntervalSeconds": 30,
    "MaxVideoFrames": 60,
    "FrameSceneThreshold": 0.25
  },
  "Agent": {
    "EnableToolCalling": true,
    "MaxToolIterations": 6,
    "WorkspaceRootPath": "App_Data/agent-workspace",
    "AllowWorkspaceWrite": true,
    "MaxReadChars": 8000,
    "MaxWriteChars": 200000,
    "MaxToolResultChars": 12000,
    "EnableMcpToolBridge": true,
    "MaxDirectoryEntries": 300,
    "MaxSearchMatches": 60,
    "FileRoots": [
      {
        "Name": "学习资料",
        "Path": "D:\\学习资料",
        "AllowWrite": false,
        "AllowDelete": false,
        "Enabled": true
      }
    ]
  },
  "Mcp": {
    "EnableServer": true,
    "ServerPath": "/mcp",
    "EnableClient": true,
    "Servers": [],
    "RequireClientKey": true,
    "DefaultRequestsPerMinute": 120,
    "MaxAgentClients": 50,
    "EnableCallAudit": true,
    "MaxRequestBodyBytes": 8388608
  },
  "Jobs": {
    "Enabled": true,
    "MaxConcurrentJobs": 4,
    "TypeLimits": {
      "plugin.sync": 2
    },
    "PollIntervalMs": 1000,
    "LeaseSeconds": 120,
    "MaxAttempts": 3,
    "RetryBaseSeconds": 10,
    "RetryMaxSeconds": 600,
    "RetentionHours": 168,
    "MaxQueuedJobs": 5000,
    "FeederIntervalSeconds": 2,
    "PurgeIntervalMinutes": 60
  },
  "WebSearch": {
    "Provider": "DuckDuckGo",
    "ApiKey": "",
    "BingEndpoint": "https://api.bing.microsoft.com/v7.0/search",
    "TavilyEndpoint": "https://api.tavily.com/search",
    "MaxResults": 5,
    "TimeoutSeconds": 15,
    "UserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36"
  },
  "Plugins": {
    "Enabled": true,
    "RootPath": "App_Data/plugins",
    "EnabledPluginIds": [],
    "StartupTimeoutSeconds": 30,
    "MaxInvocationTimeoutMs": 120000,
    "HealthIntervalSeconds": 30,
    "EnableToolBridge": true,
    "RestartOnCrash": true,
    "MaxRestartBackoffSeconds": 60,
    "MaxIngestionItemsPerBatch": 200,
    "DefaultMaxDocumentsPerPlugin": 5000,
    "IntegrityPolicy": "warn",
    "TrustedPublisherKeys": [],
    "AutoGrantPermissions": false,
    "RequireConfirmationForSideEffects": true,
    "KeepVersions": 3,
    "MaxPackageBytes": 268435456,
    "DrainTimeoutSeconds": 15,
    "ScheduledSyncEnabled": true,
    "MinScheduledSyncIntervalSeconds": 60,
    "Isolation": {
      "Mode": "require",
      "ReadableRoots": [],
      "WritableRoots": [],
      "ContainerNamePrefix": "MyFirstMafAgent.Plugin",
      "DeleteProfileOnUninstall": false,
      "RedirectUserDirectories": true
    }
  }
}
