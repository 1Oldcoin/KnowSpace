# ============================================================================
# MyFirstMafAgent .gitignore
# 原则：只提交源码、脚本和配置模板；忽略构建产物、运行时数据、
#       第三方依赖/二进制、本地敏感配置和临时文件。
# ============================================================================

# ---------------------------------------------------------------------------
# 1. .NET / Visual Studio 构建产物
# ---------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
# 例外：ExternalTools 下的便携 PostgreSQL 自带 bin/lib/share，属于要分发的运行时
!MyFirstMafAgent.Api/ExternalTools/pgSQL/**/bin/
!MyFirstMafAgent.Api/ExternalTools/pgSQL/**/lib/
.vs/
artifacts/
publish/
project.lock.json
*.pdb
*.nupkg
*.snupkg
*.tsbuildinfo
*.cache

# IDE 用户文件
*.user
*.suo
*.userosscache
*.userprefs
*.sln.docstates
*.DotSettings.user
*.VC.db
*.VC.opendb
_ReSharper*/
*.ReSharper

# VS Code（保留团队共享配置）
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json

# 测试输出与覆盖率
TestResults/
.testrunner/
.finaltest/
*.trx
*.coverage
coverage*.xml
coverage*.json
coverage*.info

# ---------------------------------------------------------------------------
# 2. 前端（Vue 3 + Vite）
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
.vitest/
coverage/
*.local
.eslintcache
*.timestamp-*-*.mjs

# 前端构建结果（发布时复制到 Kestrel 静态目录，属于生成物）
MyFirstMafAgent.Api/wwwroot/

# Electron 壳：依赖与打包生成物
desktop-electron/node_modules/
desktop-electron/dist/
desktop-electron/out/

# ---------------------------------------------------------------------------
# 3. 运行时数据 / 本地数据库
#    2026-10 起 **运行时数据不再入库**（便携 PostgreSQL 的 pgdata 与 uploads）。
#    原因：跑一次开发环境就产生上百个二进制文件变更，每次 PR 的 diff 里都混着
#    一堆无法 review 的差异；而且 pgdata 与 PostgreSQL 大版本绑死，PG18 打不开
#    PG17 的数据目录。代码本身支持「数据目录不存在就 initdb」，所以 clone 后
#    首次启动会自己建库建表，不需要靠提交数据库来做到“开箱即用”。
#    只排除运行期临时/锁文件与日志，避免污染仓库或让新机器起不来。
# ---------------------------------------------------------------------------
**/App_Data/pgdata/
**/App_Data/uploads/
**/pglogs/
**/pg_stat_tmp/
**/postmaster.pid
**/postmaster.opts
*.bak
*.dump
*.pgdump

# ---------------------------------------------------------------------------
# 4. 第三方二进制与模型
#    2026-10 起 Embedding 模型（bge-small-zh-v1.5）与便携 PostgreSQL 随仓库分发；
#    ffmpeg 三个 exe 均 >100MiB，走 Git LFS（见 .gitattributes）。
#    Whisper 语音模型（gguf / ggml）仍不入库，运行时自动下载。
# ---------------------------------------------------------------------------
*.gguf
ggml-*.bin
dotnet/

# ---------------------------------------------------------------------------
# 5. 本地配置与敏感信息
#    建议把密钥放在 appsettings.Local.json 或 dotnet user-secrets 中
# ---------------------------------------------------------------------------
appsettings.Local.json
appsettings.*.local.json
secrets.json
.env
.env.*
!.env.example
*.pfx
*.snk
*.pem
*.key
*.crt
*.cer

# ---------------------------------------------------------------------------
# 6. 日志、临时文件与调试输出
# ---------------------------------------------------------------------------
logs/
*.log
*.tmp
*.temp
*.swp
*.swo
*~
~$*
*.orig
*.rej
/probe-out*.txt
/rowdump.txt

# ---------------------------------------------------------------------------
# 7. 编辑器 / 操作系统杂项
# ---------------------------------------------------------------------------
.idea/
*.iml
.DS_Store
Thumbs.db
desktop.ini
._*

# ---------------------------------------------------------------------------
# 9. 第三方交接报告：里面常带真实令牌 / 数据库口令 / MCP 密钥
#    这份报告是外部测试同事交付的原始记录，不随仓库分发。
#    需要留档时先脱敏，再另存为 docs/ 下的正式文档。
# ---------------------------------------------------------------------------
MyFirstMafAgent.Api.Tests/TestReport/
